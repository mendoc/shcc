#!/bin/bash
set -e

# Installation de shcc depuis les GitHub Releases
REPO="mendoc/shcc"
INSTALL_DIR="/usr/local/bin"

echo "Recherche de la dernière version de shcc..."
# Nettoyage amélioré pour supprimer les espaces et guillemets
LATEST_URL=$(curl -s https://api.github.com/repos/$REPO/releases/latest | grep "browser_download_url.*shcc-linux" | cut -d : -f 2,3 | tr -d ' "' | tr -d ' ')

if [ -z "$LATEST_URL" ]; then
    echo "❌ Impossible de trouver une release pour shcc-linux."
    exit 1
fi

echo "Téléchargement depuis $LATEST_URL..."
# Utilisation de -L pour suivre les redirections GitHub
sudo curl -fsSL -L "$LATEST_URL" -o /tmp/shcc
sudo chmod +x /tmp/shcc
sudo mkdir -p "$INSTALL_DIR"
sudo mv /tmp/shcc "$INSTALL_DIR/shcc"

echo "✅ shcc a été installé avec succès."
shcc status
